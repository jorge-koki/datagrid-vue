{
  "name": "vue-tablekit",
  "version": "0.3.1",
  "description": "High-performance virtualized data grid for Vue 3, with DOM node recycling, cell editing, custom renderers and persistent column layout.",
  "license": "MIT",
  "author": "jorge-koki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorge-koki/vue-tablekit.git"
  },
  "homepage": "https://github.com/jorge-koki/vue-tablekit#readme",
  "bugs": {
    "url": "https://github.com/jorge-koki/vue-tablekit/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "datagrid",
    "datatable",
    "virtual-scroll",
    "virtualization",
    "table",
    "grid",
    "typescript",
    "nuxt-ui"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/vue-tablekit.js",
  "module": "./dist/vue-tablekit.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-tablekit.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:demo:pages": "vite build --base=/vue-tablekit/",
    "build:lib": "run-s build:lib-bundle build:lib-types",
    "build:lib-bundle": "vite build --mode lib",
    "build:lib-types": "vue-tsc -p tsconfig.lib.json",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt src/ demo/",
    "format:check": "oxfmt --check src/ demo/",
    "verify": "run-s type-check test format:check build:lib",
    "prepublishOnly": "run-s type-check test",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "vue": "^3.5.0 || >=3.6.0-0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.0.1",
    "vue": "rc",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
